{
  "manifest_version": 3,
  "name": "Tibetan Lens",
  "version": "0.50.21",
  "description": "Segments Tibetan text on web pages, inserts spacing, and shows dictionary popups.",
  "default_locale": "en",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "icons": {
    "16": "public/icons/icon16.png",
    "48": "public/icons/icon48.png",
    "128": "public/icons/icon128.png"
  },
  "action": {
    "default_title": "Tibetan Lens",
    "default_icon": "public/icons/icon48.png",
    "default_popup": "src/popup/index.html"
  },
  "options_page": "src/options/index.html",
  "web_accessible_resources": [
    {
      "resources": [
        "public/data/resources/SylComponents.json",
        "public/data/dialect_packs/botok_general/dictionary/words/tsikchen.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/uncompound_lexicon.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/ancient.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/exceptions.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/dagdra.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/hopkins.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/84000.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/curated_glosses.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/pos_overrides.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/gloss_pos_inferred.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/soas_pos.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words/actib_pos.tsv",
        "public/data/dialect_packs/botok_general/dictionary/words_non_inflected/particles.tsv"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/i18n.js",
        "src/shared/defaults.js",
        "src/shared/storage.js",
        "src/shared/tibetan.js",
        "src/shared/jsewts.js",
        "src/shared/ewts-converter.js",
        "src/core/botokPackManifest.js",
        "src/core/botokTokenizer.js",
        "src/core/mockDictionary.js",
        "src/content/replacement-engine.js",
        "src/content/tooltip.js",
        "src/content/content-script.js"
      ],
      "css": [
        "src/content/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
